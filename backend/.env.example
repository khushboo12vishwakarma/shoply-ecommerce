# ── Django core ──────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# ── Database ─────────────────────────────────────────────────
# Leave DATABASE_URL empty to use a local sqlite file (dev).
# In Docker this is set to the Postgres service.
# DATABASE_URL=postgres://ecom:ecom@db:5432/ecom
DATABASE_URL=

# ── CORS (frontend origins allowed to call the API) ──────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── JWT ──────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MIN=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Media / Static ───────────────────────────────────────────
TIME_ZONE=UTC
